# Laravel API (server side only - never exposed to the phone)
LARAVEL_API_BASE=https://api.lebbas.com/api/v1
LARAVEL_API_TOKEN=

# Must be IDENTICAL to DRIVER_DESK_SECRET in the Laravel .env
DESK_SECRET=change-me-to-a-long-random-string

# Road routing (optional). The public demo server is fine for testing;
# for production use your own OSRM / OpenRouteService / Google.
# NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# Optional look & feel
# NEXT_PUBLIC_LOGO_URL=https://lebbas.com/logo.png
# NEXT_PUBLIC_TILES_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
